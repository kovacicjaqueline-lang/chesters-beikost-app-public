{
  "name": "chesters-beikost-app",
  "version": "10.1.26",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run",
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "test:browser": "node browser-tests/ui-meal-editor-webkit.test.mjs && node browser-tests/planned-recipe-details-webkit.test.mjs && node browser-tests/ui-settings-tab-state-webkit.test.mjs && node browser-tests/unified-food-log-webkit.test.mjs && node browser-tests/planner-random-swap-webkit.test.mjs",
    "verify:icons": "node --test tests/*icon*.test.cjs tests/legacy-recipe-assets-cleanup.test.cjs",
    "verify:fast": "npm test",
    "verify:app": "npm run verify:fast && npm run test:browser",
    "verify:deploy": "npm run check:deploy && cd js && npx wrangler deploy --dry-run",
    "verify": "npm run verify:app && npm run verify:deploy"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "wrangler": "^4.102.0"
  }
}
