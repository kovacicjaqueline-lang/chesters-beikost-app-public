{
  "name": "chesters-beikost-app",
  "version": "10.1.26",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run",
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "verify:icons": "node --test tests/*icon*.test.cjs tests/legacy-recipe-assets-cleanup.test.cjs",
    "verify:fast": "npm test",
    "verify:app": "npm run verify:fast && npm run test:browser",
    "verify:deploy": "npm run check:deploy && cd js && npx wrangler deploy --dry-run",
    "verify": "npm run verify:app && npm run verify:deploy"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "wrangler": "^4.102.0"
  }
}
